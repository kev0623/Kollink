# Supabase（本機用 `npx supabase status -o env` 查看：PUBLISHABLE_KEY、SECRET_KEY）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 只能在伺服器端使用，絕對不要加 NEXT_PUBLIC_ 前綴
SUPABASE_SECRET_KEY=

# Google 登入：在 Google Cloud 建好 OAuth 用戶端並填入下面兩個值後，改成 true
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# LINE 登入（README「社群登入設定 → LINE 登入」）。三個都設定才會啟用；本機沒有 LINE 頻道時保持 false。
# LINE_CHANNEL_SECRET 只能在伺服器端，絕對不要加 NEXT_PUBLIC_ 前綴。LINE 的 redirect_uri 由下面的 SITE_URL 組成。
NEXT_PUBLIC_LINE_AUTH_ENABLED=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# 綠界 ECPay：只在伺服器端，絕對不要加 NEXT_PUBLIC_。
# 本機用綠界公開的測試商店（https://developers.ecpay.com.tw/2856/），不會真的扣款；正式金鑰不要寫進任何檔案。
# 少任何一個時「確認並付款」會停用。這些測試值只用在本機，不要設到 Vercel（Production 與 Preview 都不要）。
ECPAY_ENV=stage
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
# 站台網址（只有 origin，不要結尾斜線以外的路徑），用來組綠界與 LINE 登入的回呼網址。本機用 localhost（綠界連不到，見 README）
SITE_URL=http://localhost:3000

# Vercel Cron（審核逾期自動通過）：/api/cron/auto-approve 只接受 Authorization: Bearer <CRON_SECRET>
# 本機隨便填一個值即可；正式環境要加到 Vercel 的 Production 環境變數
CRON_SECRET=
